# ---------------------------------------------------------------- optional --
# Claude API key. Everything except AI chat, auto-tagging and summaries works
# without it. Can also be set from the in-app Settings screen.
ANTHROPIC_API_KEY=

# Where the SQLite database, uploaded files and models live.
# Local default: ./data   On Railway: /data (the mounted volume)
# EVERNOTION_DATA_DIR=./data

# ------------------------------------------------------- REQUIRED IN PROD ---
# Password gate. Leave unset for local use; anything deployed to a public URL
# MUST set this, or anyone with the address can read and edit every note and
# download every PDF.
# EVERNOTION_PASSWORD=

# Optional: signing key for session cookies. Defaults to EVERNOTION_PASSWORD,
# which means changing the password logs everyone out — usually what you want.
# EVERNOTION_SECRET=
